<?xml version="1.0" encoding="utf-8"?>
<!-- Container only. The qualified main_screen_content layouts (portrait / landscape) are inflated into it
     by MainScreenFragment, which re-inflates on rotation because MainActivity handles orientation changes itself. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipChildren="false"
    android:clipToPadding="false" />
